<?xml version="1.0" encoding="utf-8"?>
<!--
  Резервное копирование и перенос на другое устройство отключены полностью:
  в настройках лежит секрет MTProto-прокси (tgSecret), и отдавать его в облако
  или в перенос мы не хотим. Пользовательская копия делается вручную:
  «Настройки → Резервная копия → Экспорт» (секрет в неё не попадает).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
