<?xml version="1.0" encoding="utf-8"?>
<!--
  То же, что data_extraction_rules.xml, но для Android 11 и ниже: никаких
  облачных копий и переносов — в настройках лежит секрет MTProto-прокси.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
