<?xml version="1.0" encoding="utf-8"?>
<!--
  Монохромный знак Zapret Manager: замок из фирменной иконки с молнией вместо
  скважины. Используется и как иконка плитки быстрых настроек, и как small icon
  уведомлений, поэтому рисуется одним цветом (#FFFFFFFF) без градиентов —
  SystemUI сам тонирует его под состояние плитки.

  Геометрия: корпус с закруглением 2.8, дужка радиуса 3.95 штрихом 2, молния
  вырезана через evenOdd. viewport 22.4 вместо 24 — знак крупнее в том же
  24dp-боксе, иначе на плитке он выглядит мелким.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="22.4"
    android:viewportHeight="22.4">

    <group
        android:translateX="-0.8"
        android:translateY="-0.8">

        <!-- Дужка замка -->
        <path
            android:fillColor="#00000000"
            android:pathData="M8.1,10.4 L8.1,8.2 A3.95,3.95 0 0 1 15.9,8.2 L15.9,10.4"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round"
            android:strokeWidth="2" />

        <!-- Корпус замка с молнией-вырезом (молния центрирована по корпусу) -->
        <path
            android:fillColor="#FFFFFFFF"
            android:fillType="evenOdd"
            android:pathData="M8.7,9.5 L15.3,9.5 A2.8,2.8 0 0 1 18.1,12.3 L18.1,17.8 A2.8,2.8 0 0 1 15.3,20.6 L8.7,20.6 A2.8,2.8 0 0 1 5.9,17.8 L5.9,12.3 A2.8,2.8 0 0 1 8.7,9.5 Z M13.35,11.05 L9.25,15.85 L11.45,15.85 L10.65,18.95 L14.75,14.05 L12.55,14.05 Z" />
    </group>
</vector>
